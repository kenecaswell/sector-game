{
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        // Type-check only. Vite loads vite.config.ts itself; emitting would write a
        // vite.config.js next to it, which Vite would then load instead.
        "noEmit": true
    },
    "include": ["vite.config.ts"]
}
